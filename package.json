{
  "name": "@antelopejs/dms-lang",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-lang.git"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "frontend-vue"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev:frontend": "pnpm --dir playground frontend:dev",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && oxfmt --check . && pnpm --dir frontend-vue lint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "test": "pnpm run build && ajs module test .",
    "test:unit": "pnpm build && mocha dist/test/locale-discovery.test.js && node --test tests/*.test.mjs",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "release": "pnpm run lint && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.14 <1.0.0",
    "@antelopejs/interface-api-util": "^0.1.2",
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0",
    "@antelopejs/interface-dms": ">=0.2.0 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/core": "1.9.1",
    "@antelopejs/dms": ">=0.4.0 <1.0.0",
    "@antelopejs/dms-frontend": "0.2.6",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "chai": "^6.2.2",
    "knip": "^6.34.0",
    "mocha": "^12.0.0",
    "mongodb-memory-server-core": "^11.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [],
    "test": "src/test/harness.ts"
  }
}
