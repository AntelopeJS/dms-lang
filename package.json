{
  "name": "@antelopejs/dms-lang",
  "version": "0.4.1",
  "description": "Language and translation management for the AntelopeJS DMS: coverage overview, translation matrix, translation queue and public translation workspaces.",
  "keywords": [
    "antelopejs",
    "dms",
    "dms-module",
    "i18n",
    "localization",
    "translations"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/lang",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-lang/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-lang.git"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev:frontend": "pnpm --dir playground frontend:dev",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "ajs project dev -w -p playground",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && pnpm --dir frontend-vue lint && node scripts/check-locales.mts && node scripts/check-dms-versions.mjs && antelopejs-check-interface-ranges",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "test": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && DMS_PREBUILT=1 ajs module test . && node --test tests/*.test.mjs",
    "test:unit": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && mocha dist/test/locale-discovery.test.js dist/test/write-target.test.js && node --test tests/*.test.mjs",
    "test:node": "[ -n \"$DMS_PREBUILT\" ] || pnpm run build && node --test tests/*.test.mjs",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "release": "pnpm run lint && pnpm run format:check && release-it",
    "prepack": "pnpm run build",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-fc8048d.tgz",
    "@antelopejs/interface-api-util": "file:.campaign/tgz/antelopejs-interface-api-util-cc740f8.tgz",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-0cfaaa3.tgz",
    "@intlify/message-compiler": "^11.1.12",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@antelopejs/api": "file:.campaign/tgz/antelopejs-api-6afe3e2.tgz",
    "@antelopejs/core": "1.17.1",
    "@antelopejs/dms": "file:.campaign/tgz/antelopejs-dms-0cfaaa3.tgz",
    "@antelopejs/dms-frontend": "0.9.1",
    "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
    "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
    "@antelopejs/interface-database-decorators": "file:.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
    "@antelopejs/tooling-configs": "file:.campaign/tgz/antelopejs-tooling-configs-a423d41.tgz",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "chai": "^6.2.2",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mocha": "^12.0.0",
    "mongodb-memory-server-core": "^11.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-fc8048d.tgz",
      "@antelopejs/tooling-configs": "file:.campaign/tgz/antelopejs-tooling-configs-a423d41.tgz",
      "@antelopejs/interface-api-util": "file:.campaign/tgz/antelopejs-interface-api-util-cc740f8.tgz",
      "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
      "@antelopejs/interface-database-decorators": "file:.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
      "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
      "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-0cfaaa3.tgz",
      "@antelopejs/dms": "file:.campaign/tgz/antelopejs-dms-0cfaaa3.tgz",
      "@antelopejs/dms>@antelopejs/interface-core": "0.2.6",
      "@antelopejs/api": "file:.campaign/tgz/antelopejs-api-6afe3e2.tgz",
      "@antelopejs/api>@antelopejs/interface-core": "0.2.6"
    }
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [],
    "test": "src/test/harness.ts",
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
