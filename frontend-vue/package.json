{
  "name": "@antelopejs/dms-lang-frontend-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dms.frontend.ts",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "@antelopejs/dms-frontend": ">=0.10.0 <0.11.0"
  },
  "scripts": {
    "build": "pnpm --dir ../playground exec ajs dms build",
    "dev": "pnpm --dir ../playground frontend:dev",
