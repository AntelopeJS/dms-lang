    "format": "prettier --write .",
    "format:check": "prettier --check --log-level warn .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.21.0",
    "@antelopejs/dms": ">=0.19.5 <0.20.0",
    "@antelopejs/dms-frontend": ">=0.10.4 <0.11.0",
    "@antelopejs/tooling-configs": ">=0.7.0 <0.8.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@vueuse/core": "^14.4.0",
    "eslint": "^9",
    "globals": "^15",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^6.0.3",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "@nuxt/ui": "4.10.0",
    "@vueuse/core": "^14.4.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@intlify/message-compiler": "^11.1.12"
